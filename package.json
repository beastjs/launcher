{
  "name": "launcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve --mode development",
    "build": "rspack build --mode production",
    "preview": "serve -s dist -l 4173",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run check:imports && bun run typecheck && bun run build",
    "gen": "bun scripts/gen/index.ts",
    "repos:update:effect": "bun scripts/repos/update.effect.sh",
    "check:imports": "bun scripts/checks/repo-imports.ts",
    "icons:build": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts",
    "icons:check": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts --check"
  },
  "dependencies": {
    "@beast-ui/icons": "^0.1.0",
    "@beastjs/use-sound": "^6.0.0",
    "@iconify/utils": "^3.1.7",
    "@octanejs/base-ui": "0.1.55",
    "@octanejs/motion": "^0.1.54",
    "@octanejs/resizable-panels": "^0.0.22",
    "@octanejs/sonner": "^0.1.59",
    "@octanejs/tanstack-router": "^0.2.6",
    "@octanejs/vaul": "^0.0.32",
    "beast-tsrx": "0.8.0",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "effect": "^4.0.2",
    "fflate": "^0.8.3",
    "lenis": "^1.3.26",
    "octane": "0.12.0",
    "shiki": "^4.5.0",
    "svgo": "^4.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@beastjs/devtools": "^0.1.21",
    "@beastjs/page-builder": "^0.1.0",
    "@octanejs/rspack-plugin": "^0.2.2",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/node": "^26.2.0",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
