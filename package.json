{
  "name": "launcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run check:imports && bun run typecheck && bun run build",
    "gen": "bun scripts/gen/index.ts",
    "repos:update:effect": "bun scripts/repos/update.effect.sh",
    "check:imports": "bun scripts/checks/repo-imports.ts",
    "icons:build": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts",
    "icons:check": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts --check"
  },
  "dependencies": {
    "@beastjs/use-sound": "^6.0.0",
    "@iconify/utils": "^3.1.7",
    "@octanejs/base-ui": "0.1.58",
    "@octanejs/motion": "^0.1.57",
    "@octanejs/resizable-panels": "^0.0.16",
    "@octanejs/tanstack-router": "^0.1.60",
    "@octanejs/vaul": "^0.0.25",
    "beast-tsrx": "0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.0",
    "fflate": "^0.8.3",
    "octane": "0.7.1",
    "shiki": "^4.5.0",
    "svgo": "^4.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@beastjs/devtools": "^0.1.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tsrx/typescript-plugin": "0.6.1",
    "@types/node": "^26.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
