{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "@tsrx/typescript-plugin"
      }
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "rspack.config.ts"
  ],
  "tsrx": {
    "compiler": "octane"
  },
  "exclude": [
    "repos",
    "node_modules",
    "dist"
  ]
}
