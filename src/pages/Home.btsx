import HyperHex  from "../components/HyperHex.btsx";
import { tiles } from "@/lib/tiles"
import { Icon } from "@/lib/icons"
import HyperList from "@/components/ui/HyperList.btsx";

module
  // The tile coordinates describe distances along the cylinder's surface.
  // A smaller radius makes the ends turn away more sharply.
  const CYLINDER_ARC = 0.25
  const PERSPECTIVE = 1200
  const minX = Math.min(...tiles.map(tile => tile.posX))
  const maxX = Math.max(...tiles.map(tile => tile.posX))
  const centerX = (minX + maxX) / 2.2
  const centerY = (Math.min(...tiles.map(tile => tile.posY)) + Math.max(...tiles.map(tile => tile.posY))) / 2
  const radius = (maxX - minX) / (2 * CYLINDER_ARC)
  const cylinderTiles = tiles.map(tile => {
    const angle = (tile.posX - centerX) / radius
    const depth = radius * (Math.cos(angle) - 1)
    const scale = PERSPECTIVE / (PERSPECTIVE - depth)
    return {
      ...tile,
      posX: centerX + radius * Math.sin(angle) * scale,
      posY: centerY + (tile.posY - centerY) * scale,
      angle: angle * 180 / Math.PI,
      scale,
      shade: 1 - (1 - Math.cos(angle)) * 0.35,
    }
  })
  type CylinderTile = typeof cylinderTiles[number]

component HeatTile
  props item: CylinderTile
  a(
    ~ className="group/tile absolute"
    ~ href={item.href}
    ~ target="_blank"
    ~ rel="noopener noreferrer"
    ~ aria-label={item.label}
    ~ title={item.label}
    ~ style={{
    ~ left: `${item.posX}px`,
    ~ top: `${item.posY}px`,
    ~ width: '80px',
    ~ height: '50px',
    ~ marginLeft: '-40px',
    ~ marginTop: '-25px',
    ~ transform: `perspective(${PERSPECTIVE}px) rotateY(${item.angle}deg) scale(${item.scale})`,
    ~ filter: `brightness(${item.shade})`,
    ~ }}
    ~ )
    div(className="absolute left-1/2 top-1/2")
      HyperHex(posX={0} posY={0})
        Icon(name={'mechanics'} size={14} className="-rotate-30 text-foreground/10 invert" solid)

props {}:{}


div(className="md:col-span-7 col-span-8 size-full flex items-center justify-center")
  div(className="relative w-full h-full overflow-x-scroll")
    div(className="md:h-4 w-full")
    HyperList(
      ~ keyId="tileId"
      ~ randomStagger
      ~ stagger={0.06}
      ~ direction="up"
      ~ component={HeatTile}
      ~ data={cylinderTiles}
      ~ max={tiles.length}
      ~ container="relative h-full min-w-[560px] overflow-visible"
      ~ itemStyle="absolute left-0 top-0 size-0 overflow-visible"
      ~ )
