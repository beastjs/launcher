import { useState } from 'octane'
import { Link } from '@octanejs/tanstack-router'
import { useIconFavorites } from '@/hooks/use-icon-favorites'
import { useSearchShortcut } from '@/hooks/use-search-shortcut'
import IconGrid from '@/components/IconGrid.btsx'
import { Icon } from '@/lib/icons'

props {}:{}
setup
  const { favorites, keys, toggle, error } = useIconFavorites()
  const [query, setQuery] = useState('')
  const [size, setSize] = useState(32)
  const inputRef = useSearchShortcut()
  const term = query.trim().toLowerCase()
  const icons = favorites.filter(icon => `${icon.name} ${icon.sourceSetId}`.includes(term))

section(className="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8 sm:py-12")
  Link(to="/icons" className="mb-6 inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground")
    Icon(name="arrow-left" size={14})
    span All icon sets
  header
    h1(className="text-3xl font-semibold tracking-tight") Favorite Icons
    p(className="mt-3 text-sm leading-6 text-muted-foreground") Your saved icons from every collection, stored in this browser.
  div(className="my-6 flex flex-wrap items-end gap-4 rounded-xl border border-border/25 bg-card p-4")
    label(className="min-w-40 flex-1 text-xs text-muted-foreground")
      span Search favorites
      input(ref={inputRef} type="search" value={query} aria-keyshortcuts="/" placeholder="Search by icon or collection…" onInput={(event: Event) => setQuery((event.currentTarget as HTMLInputElement).value)} className="mt-2 w-full rounded-lg border border-border/30 bg-background px-3 py-2 text-sm text-foreground outline-none focus:ring-2 focus:ring-ring")
    label(className="w-40 text-xs text-muted-foreground")
      span #{`Preview size · ${size}px`}
      input(type="range" min="16" max="64" step="8" value={size} onInput={(event: Event) => setSize(Number((event.currentTarget as HTMLInputElement).value))} className="mt-4 w-full accent-foreground")
    p(className="pb-2 font-mono text-xs text-muted-foreground" role="status") #{`${icons.length} / ${favorites.length}`}
  if error
    p(className="mb-4 text-xs text-destructive" role="alert") #{error}
  if !icons.length
    p(className="rounded-xl border border-dashed border-border/30 p-8 text-center text-sm text-muted-foreground") #{favorites.length ? 'No favorites match your search.' : 'No favorites yet. Save icons using the star on each card.'}
  IconGrid(icons={icons} size={size} favoriteKeys={keys} onToggleFavorite={toggle} showCollection={true})
