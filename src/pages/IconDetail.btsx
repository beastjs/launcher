import { useMemo, useState } from 'octane'
import { Link, useParams } from '@octanejs/tanstack-router'
import { useIconEntry } from '@/hooks/use-icon-entry'
import { useSvgOptimizer } from '@/hooks/use-svg-optimizer'
import { useBlobUrl } from '@/hooks/use-blob-url'
import { useCopy } from '@/hooks/use-copy'
import { useIconFavorites } from '@/hooks/use-icon-favorites'
import { iconKey } from '@/lib/icon-favorites'
import { getSvgElementSnippet, type IconEntry } from '@/lib/iconify'
import Button from '@/components/ui/Button.btsx'
import { Icon } from '@/lib/icons'
import AddIconToList from '@/components/AddIconToList.btsx'
import { svgSymbol } from '@/lib/svg-symbol'

module
  const bytesLabel = (bytes: number) => bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(2)} KB`

component SvgPanel
  props { title, svg, url, bytes }: { title: string; svg: string; url: string | null; bytes: number | null }
  article(className="min-w-0 overflow-hidden rounded-2xl border border-border/25 bg-card")
    header(className="flex items-center justify-between gap-3 border-b border-border/20 px-5 py-4")
      h2(className="text-sm font-medium") #{title}
      span(className="font-mono text-xs text-muted-foreground") #{bytes === null ? '—' : bytesLabel(bytes)}
    div(className="grid h-52 place-items-center bg-[conic-gradient(#f1f1f1_25%,#fff_0_50%,#f1f1f1_0_75%,#fff_0)] bg-[size:16px_16px] p-6")
      if url
        img(src={url} alt={`${title} icon preview`} width="96" height="96" className="size-24 object-contain")
      else
        span(className="text-xs text-neutral-500") Preview will appear here
    label(className="block border-t border-border/20 p-4")
      span(className="mb-2 block text-xs text-muted-foreground") #{`${title} SVG source`}
      textarea(value={svg} readOnly={true} spellCheck={false} rows={10} className="w-full resize-y rounded-lg border border-border/25 bg-background p-3 font-mono text-xs leading-5 outline-none focus:ring-2 focus:ring-ring")

component Optimizer
  props { icon }: { icon: IconEntry }
  setup
    const [precision, setPrecision] = useState(3)
    const [multipass, setMultipass] = useState(true)
    const [removeDimensions, setRemoveDimensions] = useState(false)
    const [pretty, setPretty] = useState(false)
    const source = useMemo(() => getSvgElementSnippet(icon), [icon])
    const sourceBlob = useMemo(() => new Blob([source], { type: 'image/svg+xml' }), [source])
    const sourceUrl = useBlobUrl(sourceBlob)
    const { result, error, working, retry } = useSvgOptimizer(source, { precision, multipass, removeDimensions, pretty })
    const resultBlob = useMemo(() => result ? new Blob([result.svg], { type: 'image/svg+xml' }) : null, [result])
    const resultUrl = useBlobUrl(resultBlob)
    const { copy, copiedName, error: copyError } = useCopy()
    const { keys, toggle, error: favoriteError } = useIconFavorites()
    const isFavorite = keys.has(iconKey(icon))
    const sourceBytes = sourceBlob.size
    const symbol = useMemo(() => {
      if (!result) return ''
      return `${JSON.stringify(icon.name)}: ${JSON.stringify({ ...svgSymbol(result.svg), set: icon.sourceSetId }, null, 2)}`
    }, [result, icon])
  div(className="mt-6 flex flex-wrap items-center gap-3")
    Button(label={isFavorite ? 'Remove favorite' : 'Save favorite'} aria-pressed={isFavorite} onClick={() => toggle(icon)} variant="ghost")
    p(className="text-xs text-muted-foreground" role="status") #{working ? 'Optimizing SVG…' : result ? `${bytesLabel(result.originalBytes)} → ${bytesLabel(result.optimizedBytes)} · ${Math.abs(result.savings).toFixed(1)}% ${result.savings >= 0 ? 'smaller' : 'larger'}` : 'Ready to optimize'}
  AddIconToList(svg={result?.svg ?? ''} name={`${icon.sourceSetId}-${icon.name}`} disabled={!result || working})
  div(className="my-6 flex flex-wrap items-end gap-5 rounded-xl border border-border/25 bg-card p-4")
    label(className="w-44 text-xs text-muted-foreground")
      span #{`Decimal precision · ${precision}`}
      input(type="range" min="0" max="6" step="1" value={precision} onInput={(event: Event) => setPrecision(Number((event.currentTarget as HTMLInputElement).value))} className="mt-4 w-full accent-foreground")
    label(className="flex items-center gap-2 pb-1 text-xs")
      input(type="checkbox" checked={multipass} onChange={(event: Event) => setMultipass((event.currentTarget as HTMLInputElement).checked)} className="accent-foreground")
      span Multipass
    label(className="flex items-center gap-2 pb-1 text-xs")
      input(type="checkbox" checked={removeDimensions} onChange={(event: Event) => setRemoveDimensions((event.currentTarget as HTMLInputElement).checked)} className="accent-foreground")
      span Remove width and height
    label(className="flex items-center gap-2 pb-1 text-xs")
      input(type="checkbox" checked={pretty} onChange={(event: Event) => setPretty((event.currentTarget as HTMLInputElement).checked)} className="accent-foreground")
      span Format output
    Button(label="Optimize" pending={working} pendingLabel="Optimizing…" disabled={working} onClick={retry})
  if error
    div(className="mb-5 rounded-xl bg-destructive/5 p-4")
      p(className="text-sm text-destructive" role="alert") #{error}
      Button(label="Retry optimization" onClick={retry} className="mt-3")
  if copyError || favoriteError
    p(className="mb-4 text-xs text-destructive" role="alert") #{copyError ?? favoriteError}
  div(className="grid gap-5 lg:grid-cols-2")
    SvgPanel(title="Original" svg={source} url={sourceUrl} bytes={sourceBytes})
    SvgPanel(title="Optimized" svg={result?.svg ?? ''} url={resultUrl} bytes={result?.optimizedBytes ?? null})
  div(className="mt-6 flex flex-wrap gap-3")
    Button(label={copiedName === 'optimized-svg' ? 'Copied SVG' : 'Copy optimized SVG'} disabled={!result || working} onClick={() => { if (result) void copy('optimized-svg', result.svg) }})
    Button(label={copiedName === 'optimized-symbol' ? 'Copied symbol' : 'Copy Beast symbol'} disabled={!result || working} onClick={() => void copy('optimized-symbol', symbol)} variant="ghost")
    if resultUrl && result && !working
      Button(type="a" href={resultUrl} download={`${icon.sourceSetId}-${icon.name}.svg`} label="Download SVG" variant="primary")

props {}:{}
setup
  const { iconSetId, iconName } = useParams({ from: '/icons/$iconSetId/$iconName' })
  const { icon, loading, error, retry } = useIconEntry(iconSetId, iconName)

section(className="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8 sm:py-12")
  div(className="mb-6 flex items-center justify-between gap-3")
    Link(to="/icons/$iconSetId" params={{iconSetId}} className="inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground")
      Icon(name="arrow-left" size={14})
      span #{iconSetId}
    Link(to="/icons/favorites" className="text-xs font-medium hover:underline") Favorites
  header
    p(className="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground") SVG optimizer
    h1(className="break-words text-3xl font-semibold tracking-tight") #{iconName}
    p(className="mt-3 text-sm leading-6 text-muted-foreground") Optimize this icon with SVGO and compare the result before exporting.
  if loading
    p(className="py-12 text-center text-sm text-muted-foreground" role="status") Loading icon…
  if error
    div(className="mt-6 rounded-xl bg-destructive/5 p-4")
      p(className="text-sm text-destructive" role="alert") #{error}
      Button(label="Retry" onClick={retry} className="mt-3")
  if icon
    Optimizer(key={iconKey(icon)} icon={icon})
