import { Link } from '@octanejs/tanstack-router'
import { useIconWorkspace } from '@/hooks/use-icon-workspace'
import Button from '@/components/ui/Button.btsx'
import Checkbox from '@/components/ui/checkbox.btsx'
import ScrubField from '@/components/ui/scrubfield.btsx'
import type { SvgOptimizationResult } from '../lib/svg-optimizer.ts'
import { recentCustomIcons } from '@/lib/custom-icon-set'

module
  const bytesLabel = (bytes: number) => bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(2)} KB`

module
  interface HeaderSectionProps {
    options: { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean }
    setOptions: (next: { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean } | ((prev: { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean }) => { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean })) => void
    autoOptimize: boolean
    setAutoOptimize: (next: boolean | ((prev: boolean) => boolean)) => void
    setManualRequest: (next: { source: string; options: { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean } } | ((prev: { source: string; options: { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean } } | null) => { source: string; options: { currentColor: boolean; viewBoxSize: number; precision: number; multipass: boolean; removeDimensions: boolean; pretty: boolean } } | null) | null) => void
  }

component HeaderSection
  props { options, setOptions, autoOptimize, setAutoOptimize, setManualRequest }: HeaderSectionProps
  div(className="mb-5 flex w-full flex-wrap items-center justify-between gap-3")
    header
      h2#paste-svg-heading(className="text-lg font-semibold") Optimizer
    div(className="flex flex-wrap items-center gap-x-5 gap-y-2")
      ScrubField(label="ViewBox" accent='var(--accent)' value={options.viewBoxSize} min={16} max={64} step={4} size="sm" showDirty={false} chipColor="var(--surface)" onChange={(viewBoxSize: number) => setOptions(current => ({ ...current, viewBoxSize }))})
      ScrubField(label="Precision" accent='#f52240' value={options.precision} min={0} max={6} step={1} fineMultiplier={1} size="sm" showDirty={false} chipColor="var(--surface)" onChange={(value: number) => setOptions(current => ({ ...current, precision: Math.round(value) }))})
      Checkbox(label="Auto Optimize" checked={autoOptimize} onChange={(enabled: boolean) => { setAutoOptimize(enabled); if (!enabled) setManualRequest(null) }} boxSize={16} boxRadius={4} fontSize={12} strike="none" doneOpacity={1})
      Checkbox(label="currentColor" checked={options.currentColor} onChange={(currentColor: boolean) => setOptions(current => ({ ...current, currentColor }))} boxSize={16} boxRadius={4} fontSize={12} strike="none" doneOpacity={1})
      Checkbox(label="Multipass" checked={options.multipass} onChange={(multipass: boolean) => setOptions(current => ({ ...current, multipass }))} boxSize={16} boxRadius={4} fontSize={12} strike="none" doneOpacity={1})
      Checkbox(label="Remove width and height" checked={options.removeDimensions} onChange={(removeDimensions: boolean) => setOptions(current => ({ ...current, removeDimensions }))} boxSize={16} boxRadius={4} fontSize={12} strike="none" doneOpacity={1})
      Checkbox(label="Format Output" checked={options.pretty} onChange={(pretty: boolean) => setOptions(current => ({ ...current, pretty }))} boxSize={16} boxRadius={4} fontSize={12} strike="none" doneOpacity={1})

module
  interface ActionsColumnProps {
    pasting: boolean
    paste: () => Promise<void>
    working: boolean
    source: string
    optimize: () => void
    result: SvgOptimizationResult | null
    copy: (name: string, text: string) => Promise<boolean>
    copiedName: string | null
    resultUrl: string | null
    setSource: (next: string | ((prev: string) => string)) => void
    setPasteError: (next: string | ((prev: string | null) => string | null) | null) => void
    autoOptimize: boolean
    error: string | null
    pasteError: string | null
    copyError: string | null
  }

component ActionsColumn
  props { pasting, paste, working, source, optimize, result, copy, copiedName, resultUrl, setSource, setPasteError, autoOptimize, error, pasteError, copyError }: ActionsColumnProps
  div(className="flex min-w-0 flex-col gap-3 sm:col-span-2 lg:col-span-1")
    p(className="text-xs font-medium") Actions
    div(className="grid grid-cols-2 gap-2 lg:grid-cols-1")
      Button(label="Paste SVG" icon="paste" size="md" className="w-full" pending={pasting} pendingLabel="Pasting…" disabled={pasting} onClick={() => void paste()})
      Button(label="Optimize" icon="wrench" size="md" className="w-full" pending={working} pendingLabel="Optimizing…" disabled={!source.trim() || working} onClick={optimize})
    div(className="grid grid-cols-3 gap-2")
      Button(disabled={!result || working} onClick={() => { if (result) void copy(result.svg, result.svg) }} icon={copiedName === result?.svg ? 'check-circle' : 'copy'} aria-label={copiedName === result?.svg ? 'Copied SVG' : 'Copy optimized SVG'} title="Copy optimized SVG" size="md" variant="ghost")
      Button(type="a" href={resultUrl ?? ''} download="optimized.svg" disabled={!resultUrl || !result || working} icon="download" aria-label="Download optimized SVG" title="Download optimized SVG" size="md" variant="ghost")
      Button(onClick={() => { setSource(''); setPasteError(null) }} disabled={!source} icon="clear" aria-label="Clear SVG" title="Clear SVG" size="md" variant="ghost")
    div(className="space-y-1 border-t border-border/25 pt-3 text-xs leading-5 text-muted-foreground" role="status" aria-live="polite")
      p #{working ? 'Optimizing SVG…' : result ? `${bytesLabel(result.originalBytes)} → ${bytesLabel(result.optimizedBytes)}` : !autoOptimize && source.trim() ? 'Auto optimize is off.' : 'Ready to optimize'}
      if result
        p #{`${Math.abs(result.savings).toFixed(1)}% ${result.savings >= 0 ? 'smaller' : 'larger'}`}
    if error
      p(className="mt-3 whitespace-pre-wrap break-words text-xs text-destructive" role="alert") #{error}
    if pasteError
      p(className="mt-3 text-xs text-destructive" role="alert") #{pasteError}
    if copyError
      p(className="mt-3 text-xs text-destructive" role="alert") #{copyError}

module
  interface OriginalColumnProps {
    source: string
    setSource: (next: string | ((prev: string) => string)) => void
    sourceUrl: string | null
  }

component OriginalColumn
  props { source, setSource, sourceUrl }: OriginalColumnProps
  div(className="min-w-0")
    div(className="mb-2 flex items-center justify-between gap-3")
      label(for="paste-svg-source" className="text-xs font-medium") Original SVG
    textarea#paste-svg-source(value={source} onInput={(event: Event) => setSource((event.currentTarget as HTMLTextAreaElement).value)} placeholder={'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">…</svg>'} spellCheck={false} rows={9} className="w-full resize-y rounded-xl border border-border/25 bg-background p-3 font-mono text-xs leading-5 outline-none focus:ring-2 focus:ring-ring")
    div(className="mt-3 grid h-32 place-items-center rounded-xl dark:bg-muted-foreground p-4")
      if sourceUrl
        img(src={sourceUrl} alt="Original SVG preview" className="size-24 object-contain")
      else
        span(className="text-xs text-neutral-500") Paste an SVG to get started

module
  interface OptimizedColumnProps {
    result: SvgOptimizationResult | null
    resultUrl: string | null
  }

component OptimizedColumn
  props { result, resultUrl }: OptimizedColumnProps
  div(className="min-w-0")
    label(for="paste-svg-result" className="mb-2 block text-xs font-medium") Optimized SVG
    textarea#paste-svg-result(value={result?.svg ?? ''} readOnly={true} spellCheck={false} rows={9} placeholder="Optimized markup will appear here" className="w-full resize-y rounded-xl border border-border/25 bg-background p-3 font-mono text-xs leading-5 outline-none focus:ring-2 focus:ring-ring")
    div(className="mt-3 grid h-32 place-items-center rounded-xl dark:bg-muted-foreground p-4")
      if resultUrl
        img(src={resultUrl} alt="Optimized SVG preview" className="size-24 object-contain")
      else
        span(className="text-xs text-neutral-500") Preview will appear here

props {}:{}
setup
  const { source, setSource, options, setOptions, autoOptimize, setAutoOptimize, setManualRequest, result, error, working, optimize, sourceUrl, resultUrl, copy, copiedName, copyError, pasteError, setPasteError, pasting, paste, iconLists, selectList, iconName, setIconName, editingName, saveIcon, setEditingName, setSetError, setError, storageError, setMessage } = useIconWorkspace()
  const recentIcons = recentCustomIcons(iconLists)

section(aria-labelledby="paste-svg-heading" className="mb-10 rounded-2xl border border-border/25 bg-card p-5 sm:p-6")
  HeaderSection(options={options} setOptions={setOptions} autoOptimize={autoOptimize} setAutoOptimize={setAutoOptimize} setManualRequest={setManualRequest})
  div(className="grid grid-cols-1 gap-5 border-t border-border/50 py-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_11rem]")
    OriginalColumn(source={source} setSource={setSource} sourceUrl={sourceUrl})
    OptimizedColumn(result={result} resultUrl={resultUrl})
    ActionsColumn(pasting={pasting} paste={paste} working={working} source={source} optimize={optimize} result={result} copy={copy} copiedName={copiedName} resultUrl={resultUrl} setSource={setSource} setPasteError={setPasteError} autoOptimize={autoOptimize} error={error} pasteError={pasteError} copyError={copyError})
  div(className="mt-4 flex flex-wrap items-end gap-3 border-t border-border/25 pt-4")
    label(className="min-w-40 flex-1 text-xs text-muted-foreground")
      span Destination list
      select(value={iconLists.selected} onChange={(event: Event) => selectList((event.currentTarget as HTMLSelectElement).value)} disabled={!!editingName} className="mt-2 w-full rounded-lg border border-border/25 bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring")
        each list in iconLists.lists key list.name
          option(value={list.name}) #{list.name}
    label(className="min-w-40 flex-1 text-xs text-muted-foreground")
      span Icon name
      input(type="text" value={iconName} placeholder="arrow-right" onInput={(event: Event) => { setIconName((event.currentTarget as HTMLInputElement).value); setSetError(null) }} className="mt-2 w-full rounded-lg border border-border/25 bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring")
    Button(label={editingName ? 'Save icon changes' : 'Add to list'} disabled={!result || working || !iconName.trim()} onClick={saveIcon})
    if editingName
      Button(label="Cancel edit" onClick={() => { setEditingName(null); setIconName('') }} variant="ghost")
    Link(to="/icons/lists" className="py-2 text-xs text-muted-foreground hover:text-foreground hover:underline") Manage and download lists
  if setError
    p(className="mt-3 text-xs text-destructive" role="alert") #{setError}
  if storageError
    p(className="mt-3 text-xs text-destructive" role="alert") #{storageError}
  if setMessage
    p(className="mt-3 text-xs text-muted-foreground" role="status") #{setMessage}
  section(aria-labelledby="recent-icons-heading" className="mt-5 border-t border-border/25 pt-4")
    h3#recent-icons-heading(className="text-sm font-medium") Recently added
    if recentIcons.length
      ul(className="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5 xl:grid-cols-10")
        each item in recentIcons key `${item.listName}/${item.icon.name}`
          li(className="min-w-0 rounded-lg border border-border/25 p-1" title={`${item.icon.name} · ${item.listName}`})
            div(className="grid h-14 place-items-center rounded-md bg-white p-2")
              img(src={`data:image/svg+xml,${encodeURIComponent(item.icon.svg)}`} alt="" className="size-8 object-contain")
            p(className="mt-2 truncate ps-1 text-xs font-medium") #{item.icon.name}
            p(className="truncate ps-1 text-[10px] text-muted-foreground") #{item.listName}
    else
      p(className="mt-3 text-xs text-muted-foreground") Add an icon to a list to see your recent additions here.
