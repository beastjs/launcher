import { createElement, type OctaneNode } from 'octane'
import { Link } from '@octanejs/tanstack-router'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import Drawer, { DrawerClose, DrawerTrigger } from './ui/Drawer.btsx'
import Topbar from "./Topbar.btsx";

module
  export interface MobileSidebarProps {
    open: boolean
    onOpenChange: (open: boolean) => void
    children?: OctaneNode
    title?: string
    className?: string
  }

component Wordmark
  props { title = 'Web' }: { title?: string }
  span(className='inline-flex items-center font-sans font-medium text-base tracking-tight uppercase text-foreground') #{title}

component MobileSidebarTrigger
  props { title }: { title?: string }
  Topbar(isMobile)
    DrawerTrigger(type='button' aria-label='Open navigation' className='grid size-9 touch-manipulation place-items-center rounded-lg text-foreground/70 transition-colors hover:bg-sidebar hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring')
      Icon(name='menu' className='size-5 opacity-90')

component MobileSidebarHeader
  props { title }: { title?: string }
  div(className='shrink-0 bg-transparent')
    div(className='flex h-16 items-center justify-between gap-3 ps-6 pe-2')
      Link(to='/' aria-label='App home')
        Wordmark(title={title})
      DrawerClose(type='button' aria-label='Close navigation' className='grid size-9 touch-manipulation place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring')
        Icon(name='close' className='size-4 opacity-90')

props { children, open, onOpenChange, title = 'Mobile Web', className }: MobileSidebarProps
setup const trigger = createElement(MobileSidebarTrigger)

Drawer(
  ~ open={open}
  ~ onOpenChange={onOpenChange}
  ~ side='right'
  ~ title={title}
  ~ description='Swipe right or use the close button to close navigation.'
  ~ trigger={trigger}
  ~ className={cn('will-change-transform rounded-l-xl', className)}
  ~ contentClassName='bg-background relative w-full min-w-0 overflow-x-hidden'
  ~ backdropClassName='bg-black/20! backdrop-blur-none!'
  ~ )
  div(className='pointer-events-none absolute inset-0 overflow-hidden' aria-hidden='true')
    div(className='absolute -right-48 -top-64 size-152 rounded-full bg-cyan-200/8 blur-3xl dark:bg-lime-200/3')
  Topbar(isMobile)
  | #{children}
