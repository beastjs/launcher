import { useEffect, useState } from 'octane'
import { useSearchShortcut } from '@/hooks/use-search-shortcut'
import { Link } from '@octanejs/tanstack-router'
import { useIconMeta } from '@/hooks/use-icon-meta'
import { useIconFavorites } from '@/hooks/use-icon-favorites'
import IconGrid from './IconGrid.btsx'
import Button from './ui/Button.btsx'
import { Icon } from '@/lib/icons'

props { iconSetId }: { iconSetId: string }
setup
  const [size, setSize] = useState(32)
  const [query, setQuery] = useState('')
  const [search, setSearch] = useState('')
  const inputRef = useSearchShortcut()
  const { metadata, icons, loadingMeta, loadingIcons, loadingAll, error, hasMore, totalMatches, loadMore, loadAll, retry } = useIconMeta(iconSetId, { query: search })
  const { keys, toggle, error: favoriteError } = useIconFavorites()
  useEffect(() => { const timer = setTimeout(() => setSearch(query), 200); return () => clearTimeout(timer) }, [query])

section(className="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8 sm:py-12")
  div(className="mb-6 flex items-center justify-between gap-3")
    Link(to="/icons" className="inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground")
      Icon(name="arrow-left" size={14})
      span All icon sets
    Link(to="/icons/favorites" className="text-xs font-medium hover:underline") Favorites
  header
    p(className="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground") #{iconSetId}
    h1(className="text-3xl font-semibold tracking-tight") #{metadata?.name ?? iconSetId}
    div(className="mt-3 flex flex-wrap items-center gap-3 text-xs text-muted-foreground")
      span #{metadata ? `${metadata.total.toLocaleString()} icons` : 'Loading collection…'}
      if metadata?.author?.url
        a(href={metadata.author.url} target="_blank" rel="noopener noreferrer" className="hover:underline") #{metadata.author.name}
      if metadata?.license?.url
        a(href={metadata.license.url} target="_blank" rel="noopener noreferrer" className="hover:underline") #{metadata.license.title}
  div(className="my-6 flex flex-wrap items-end gap-4 rounded-xl border border-border/25 bg-card p-4")
    label(className="min-w-40 flex-1 text-xs text-muted-foreground")
      span Search this collection
      input(
        ~ ref={inputRef}
        ~ type="search"
        ~ value={query}
        ~ aria-keyshortcuts="/"
        ~ placeholder="Search all icons…"
        ~ onInput={(event: Event) => setQuery((event.currentTarget as HTMLInputElement).value)}
        ~ className="mt-2 w-full rounded-lg border border-border/30 bg-background px-3 py-2 text-sm text-foreground outline-none focus:ring-2 focus:ring-ring"
        ~ )
    label(className="w-40 text-xs text-muted-foreground")
      span #{`Preview size · ${size}px`}
      input(
        ~ type="range"
        ~ min="16"
        ~ max="64"
        ~ step="8"
        ~ value={size}
        ~ onInput={(event: Event) => setSize(Number((event.currentTarget as HTMLInputElement).value))}
        ~ className="mt-4 w-full accent-foreground"
        ~ )
    p(className="pb-2 font-mono text-xs text-muted-foreground" role="status") #{`${icons.length} / ${totalMatches}`}
    Button(
      ~ label={!hasMore && !loadingIcons && !loadingMeta ? 'All icons loaded' : 'Load all'}
      ~ disabled={loadingMeta || loadingIcons || !hasMore}
      ~ pending={loadingAll}
      ~ pendingLabel="Loading all…"
      ~ onClick={loadAll}
      ~ )
  if error
    div(className="mb-5 rounded-xl border border-destructive/30 bg-destructive/5 p-4")
      p(className="text-sm text-destructive" role="alert") #{error}
      Button(label="Retry" onClick={retry} className="mt-3")
  if favoriteError
    p(className="mb-4 text-xs text-destructive" role="alert") #{favoriteError}
  if loadingMeta || (loadingIcons && !icons.length)
    p(className="py-12 text-center text-sm text-muted-foreground" role="status") Loading icons…
  if !loadingMeta && !loadingIcons && !error && !icons.length
    p(className="rounded-xl border border-dashed border-border/30 p-8 text-center text-sm text-muted-foreground") No icons match your search.
  IconGrid(icons={icons} size={size} favoriteKeys={keys} onToggleFavorite={toggle})
  if hasMore && !loadingMeta
    div(className="mt-8 flex items-center justify-center gap-3")
      Button(
        ~ label="Load more"
        ~ disabled={loadingIcons}
        ~ pending={loadingIcons && !loadingAll}
        ~ pendingLabel="Loading…"
        ~ onClick={loadMore}
        ~ )
