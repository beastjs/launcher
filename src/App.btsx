import { Suspense, lazy } from "octane";
import { useMobile } from "@/hooks/use-mobile";
import Shell from "@/components/Shell.btsx";

module
  const DesktopLayout = lazy(() => import("@/layouts/DesktopLayout.btsx"))
  const MobileLayout = lazy(() => import("@/layouts/MobileLayout.btsx"))

props {}:{}
setup
  const isMobile = useMobile()

Shell
  Suspense(fallback={null})
    if isMobile
      MobileLayout
    else
      DesktopLayout
